[sqlfluff]
dialect = tsql
# No templater: the scripts are plain T-SQL (pipeline/db.py splits batches on GO).
templater = raw
# LT01: the scripts align AS aliases and comments in columns on purpose. LT05: long CASE and window lines read better unwrapped.
exclude_rules = LT01, LT05

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper
