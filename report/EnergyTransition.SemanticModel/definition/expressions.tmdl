/// SQL Server instance holding EnergyDW (Windows authentication; no credentials stored).
expression SqlServer = "localhost" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Text

/// Database name (see .env.example).
expression SqlDatabase = "EnergyDW" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Text

