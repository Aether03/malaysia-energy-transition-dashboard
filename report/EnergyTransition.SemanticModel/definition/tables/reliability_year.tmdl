table reliability_year

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	partition reliability_year = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    reliability_year = Source{[Schema="mart",Item="reliability_year"]}[Data]
				in
				    reliability_year

