table dim_region

	column region_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: region_key

	column region_code
		dataType: string
		summarizeBy: none
		sourceColumn: region_code

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name
		sortByColumn: display_order

	column display_order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: display_order

	partition dim_region = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    dim_region = Source{[Schema="mart",Item="dim_region"]}[Data]
				in
				    dim_region

