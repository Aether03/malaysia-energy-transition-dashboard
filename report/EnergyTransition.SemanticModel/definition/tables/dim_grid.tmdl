table dim_grid

	column grid_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: grid_key

	column grid_code
		dataType: string
		summarizeBy: none
		sourceColumn: grid_code

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name
		sortByColumn: display_order

	column country_name
		dataType: string
		summarizeBy: none
		sourceColumn: country_name

	column utc_offset_min
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: utc_offset_min

	column data_source_code
		dataType: string
		summarizeBy: none
		sourceColumn: data_source_code

	column demand_label
		dataType: string
		summarizeBy: none
		sourceColumn: demand_label

	column is_open_data_proxy
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_open_data_proxy

	column banner_note
		dataType: string
		summarizeBy: none
		sourceColumn: banner_note

	column display_order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: display_order

	partition dim_grid = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    dim_grid = Source{[Schema="mart",Item="dim_grid"]}[Data]
				in
				    dim_grid

