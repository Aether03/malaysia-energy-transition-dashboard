table dq_latest

	column run_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: run_id

	column rule_code
		dataType: string
		summarizeBy: none
		sourceColumn: rule_code

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column severity
		dataType: string
		summarizeBy: none
		sourceColumn: severity

	column data_source_code
		dataType: string
		summarizeBy: none
		sourceColumn: data_source_code

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column rows_affected
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: rows_affected

	column detail
		dataType: string
		summarizeBy: none
		sourceColumn: detail

	column checked_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: checked_at

	partition dq_latest = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    dq_latest = Source{[Schema="mart",Item="dq_latest"]}[Data]
				in
				    dq_latest
