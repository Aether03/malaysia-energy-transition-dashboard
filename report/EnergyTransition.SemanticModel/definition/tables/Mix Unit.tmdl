		annotation SummarizationSetBy = Automatic

	column 'Mix Unit Fields'
		isHidden
		summarizeBy: none
		sourceColumn: [Value2]
		sortByColumn: 'Mix Unit Order'

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

		annotation SummarizationSetBy = Automatic

	column 'Mix Unit Order'
		isHidden
		formatString: 0
