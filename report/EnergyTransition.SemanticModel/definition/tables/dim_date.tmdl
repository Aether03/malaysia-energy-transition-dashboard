table dim_date

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	column iso_weekday
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: iso_weekday

	column is_weekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_weekend

	column season_th
		dataType: string
		summarizeBy: none
		sourceColumn: season_th

	column season_my
		dataType: string
		summarizeBy: none
		sourceColumn: season_my

	column is_holiday_th
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday_th

	column is_holiday_my
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday_my

	column is_holiday_sg
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_holiday_sg

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    dim_date = Source{[Schema="mart",Item="dim_date"]}[Data]
				in
				    dim_date

