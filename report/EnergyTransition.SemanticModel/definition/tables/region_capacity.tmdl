table region_capacity

	column region_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: region_key

	column year
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column source_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: source_key

	column installed_mw
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: installed_mw

	column available_mw
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: available_mw

	partition region_capacity = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    region_capacity = Source{[Schema="mart",Item="region_capacity"]}[Data]
				in
				    region_capacity

