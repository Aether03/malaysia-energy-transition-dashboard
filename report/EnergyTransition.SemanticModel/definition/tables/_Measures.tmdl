		lineageTag: aed11416-3c2c-4764-aa22-ec85094b5b81

	measure 'Region Installed by Fuel (MW)' = SUM ( region_capacity[installed_mw] )
		formatString: #,0
		displayFolder: Regions
		lineageTag: e375a609-a2f5-41d3-9f96-bc90916dcf6a

	measure 'Region Card Note' = "Capacity MW at 31 Dec " & CALCULATE ( MAX ( region_annual[year] ), region_annual[metric_code] = "INSTALLED_MW" ) & " · use " & [Region Consumption Year] & " · SAIFI " & [Region SAIFI Year]
		displayFolder: Regions
		lineageTag: b16aa434-044c-4f83-9de4-9e3d4f305ea0

	measure 'Sabah vs Peninsular SAIFI' =
			VAR y = CALCULATE ( MAX ( region_annual[year] ), region_annual[metric_code] = "SAIFI", dim_region[region_code] = "SAB" )
			VAR sab = CALCULATE ( SUM ( region_annual[value] ), region_annual[metric_code] = "SAIFI", dim_region[region_code] = "SAB", dim_year[year] = y )
			VAR pen = CALCULATE ( SUM ( region_annual[value] ), region_annual[metric_code] = "SAIFI", dim_region[region_code] = "PEN", dim_year[year] = y )
			RETURN DIVIDE ( sab, pen )
		formatString: 0.0
		displayFolder: Regions
		lineageTag: 86b364d2-911f-4d27-949e-2989c4d70e5d

	measure 'P3 Title' =
			VAR y = CALCULATE ( MAX ( region_annual[year] ), region_annual[metric_code] = "SAIFI", dim_region[region_code] = "SAB", REMOVEFILTERS ( dim_region ) )
			RETURN "A Sabah customer lost supply about " & FORMAT ( [Sabah vs Peninsular SAIFI], "0" ) & "× as often as a Peninsular one in " & y
		displayFolder: Regions
		lineageTag: 4ed20217-9079-4a68-a2fd-513e2f50d109

	measure 'P3 Footnote' = "Source: Energy Commission, Malaysia Energy Statistics Handbook 2023 (pp. 13-19, 82-85). " & [Handbook Consent Notice] & " Sabah includes Labuan."
		displayFolder: Regions
		lineageTag: 1705f1f8-ce62-4b6a-a2c5-4d598f2b327e

	measure 'Reliability State Name' = SELECTEDVALUE ( dim_state[name] )
		displayFolder: State reliability
		lineageTag: 0fc905dd-0c29-4e99-beb1-25095dd86172

	measure 'Reliability Map Title' = [Reliability Metric] & " by state, " & [Reliability Year] & " (darker = less reliable)"
		displayFolder: State reliability
		lineageTag: f44f720d-35e4-41ab-87b8-f86e9b02cd4a

	measure 'Reliability Bar Title' = [Reliability Metric] & " by state, " & [Reliability Year] & " (rank 1 = most reliable)"
		displayFolder: State reliability
		lineageTag: 807e9476-085e-419c-a2a5-221f3bfa6965

	measure 'P3b Note' = "Year: leave empty for the latest (" & MAX ( reliability_year[year] ) & "). CAIDI (not shown) is misaligned for four states in 2015-2018 in both the 2022 and 2023 editions; SAIDI and SAIFI are shown as published."
		displayFolder: State reliability
		lineageTag: 80ff034d-fa3a-4867-993e-0c91ad6dab90

	measure 'P3 Subtitle' = "Peninsular Malaysia, Sabah (incl. Labuan) and Sarawak · capacity, use and supply reliability · Source: Energy Commission"
		displayFolder: Regions
		lineageTag: 94be8717-1f91-4acc-b68e-e66c93e2449f

	measure 'P3 Note' = "Sarawak's reliability table prints its years one year early; years are mapped from the 2022 edition (2015-2021), and its unproven last column is left out. Peninsular SAIFI/SAIDI are the state tables' totals."
		displayFolder: Regions
		lineageTag: ef151e5b-adb3-4e53-a9a2-d37ad4dd6120

	measure 'P3 SAIFI Bar Title' = "SAIFI by region: Sabah's is " & FORMAT ( [Sabah vs Peninsular SAIFI], "0.0" ) & "× Peninsular's"
		displayFolder: Regions
		lineageTag: b706b4cd-d20f-497a-a714-12cf78ba4267

	/// Rules checked in the latest run that recorded results; ignores page filters (counts are page-wide).
	measure 'DQ Rule Count' = CALCULATE ( COUNTROWS ( dq_latest ), REMOVEFILTERS ( dq_latest ), REMOVEFILTERS ( data_source ) ) + 0
		formatString: 0
		displayFolder: About
		lineageTag: d83023c7-acca-4849-a644-11a0279a335a

	measure 'DQ Pass Count' = CALCULATE ( COUNTROWS ( dq_latest ), REMOVEFILTERS ( dq_latest ), REMOVEFILTERS ( data_source ), dq_latest[status] = "PASS" ) + 0
		formatString: 0
		displayFolder: About
		lineageTag: 54b0bcdf-98d0-482e-9db2-311150edf5ad

	measure 'DQ Warn Count' = CALCULATE ( COUNTROWS ( dq_latest ), REMOVEFILTERS ( dq_latest ), REMOVEFILTERS ( data_source ), dq_latest[status] = "WARN" ) + 0
		formatString: 0
		displayFolder: About
		lineageTag: 8adcaf6c-b9f9-48cd-9f2b-76f809e36541

	/// Drives the nav badge on every page (M5 plan: hidden when 0).
	measure 'DQ Fail Count' = CALCULATE ( COUNTROWS ( dq_latest ), REMOVEFILTERS ( dq_latest ), REMOVEFILTERS ( data_source ), dq_latest[status] = "FAIL" ) + 0
		formatString: 0
		displayFolder: About
		lineageTag: 9036af94-1609-422d-bea7-896907d57e1e

	/// Blank text and a rail-navy fill when nothing fails, so the badge disappears into the nav rail.
	measure 'DQ Fail Badge Text' = IF ( [DQ Fail Count] > 0, FORMAT ( [DQ Fail Count], "0" ), "" )
		displayFolder: About
		lineageTag: 84e4b60c-1f4f-4189-a68d-1e01f96ef853

	measure 'DQ Fail Badge Fill' = IF ( [DQ Fail Count] > 0, "#d03b3b", "#104281" )
		displayFolder: About
		lineageTag: 3d60a5f7-9489-4430-955e-b7e8ba8aab36

	measure 'DQ Summary' =
			IF (
				[DQ Rule Count] = 0,
				"No pipeline run recorded",
				[DQ Pass Count] & " pass · " & [DQ Warn Count] & " warn · " & [DQ Fail Count] & " fail, of " & [DQ Rule Count] & " rules"
			)
		displayFolder: About
		lineageTag: 0bbfb3da-875b-4bb7-8ed0-26d32dad00a7

	/// Overlay text for the empty DQ table (doc 03 P6 state).
	measure 'DQ Empty Message' = IF ( [DQ Rule Count] = 0, "No pipeline run recorded" )
		displayFolder: About
		lineageTag: 1cecf901-fc95-4bca-8bbc-d8658c2cc072

	measure 'Latest Run ID' = MAX ( run_latest[run_id] )
		formatString: 0
		displayFolder: About
		lineageTag: 9558caba-09b4-47e0-8668-814b1e2edd11

	/// The latest completed, non-dry run (mart.run_latest), which may be transform-only. (`id` as a variable name is
	/// a SYNTAXERROR in this Desktop, like `at`.)
	measure 'Run Summary' =
			VAR runId = [Latest Run ID]
			RETURN
				IF (
					ISBLANK ( runId ),
					"No pipeline run recorded",
					"Run " & runId & " · " & MAX ( run_latest[status] ) & " · started " & FORMAT ( MAX ( run_latest[started_at] ), "yyyy-mm-dd hh:nn" )
						& ", finished " & FORMAT ( MAX ( run_latest[finished_at] ), "yyyy-mm-dd hh:nn" ) & " UTC"
				)
		displayFolder: About
		lineageTag: 3da149a1-91c2-40ad-83da-386b66de687f

	/// Rows in each source's most recent completed load (mart.source_load_latest).
	measure 'Source Rows Read' = SUM ( source_load_latest[rows_in] )
		formatString: #,0
		displayFolder: About
		lineageTag: ab487109-c813-46bb-bf23-86d5c8737cf1

	measure 'Source Rows Changed' = SUM ( source_load_latest[rows_merged] )
		formatString: #,0
		displayFolder: About
		lineageTag: 54685c1a-d755-4233-b6ea-9155b37eaa35

	/// BLANK (not "") for a source with no load, so the blank data_source row and unloaded sources drop out of the table.
	measure 'Source Last Loaded' =
			VAR loaded = MAX ( source_load_latest[loaded_at] )
			RETURN IF ( NOT ISBLANK ( loaded ), FORMAT ( loaded, "yyyy-mm-dd" ) )
		displayFolder: About
		lineageTag: d89a9312-bbf3-4ef4-bc9e-e49959d211c2

	/// Sources that need written permission, with their status (doc 03 P6 consent status).
	measure 'Consent Summary' =
			CONCATENATEX (
				FILTER ( ALLNOBLANKROW ( data_source ), data_source[consent_status] <> "OPEN" ),
				data_source[name] & ": " & SWITCH ( data_source[consent_status], "REQUESTED", "permission requested", "GRANTED", "permission granted", "REFUSED", "permission refused", data_source[consent_status] ),
				"; ",
				data_source[name]
			)
		displayFolder: About
		lineageTag: 0397cdc0-7bac-4979-9455-04828f5a1f39

	/// Status as icon + word for the DQ table chip (doc 04 §3.5: never colour alone).
	measure 'DQ Status Label' = SWITCH ( SELECTEDVALUE ( dq_latest[status] ), "PASS", "✓ Pass", "WARN", "! Warn", "FAIL", "✕ Fail" )
		displayFolder: About
		lineageTag: 7e17c674-99f5-4e4c-968f-0871e2db8dd6

	partition _Measures = calculated
		mode: import
		source = ROW ( "Value", 0 )

