	measure 'P4 Load Title' =
			VAR country = SELECTEDVALUE ( dim_grid[country_name] )
			VAR pk = CALCULATE ( [Peak Load (MW)], REMOVEFILTERS ( dim_date ), dim_date[year] = 2024 )
			VAR lf = CALCULATE ( [Load Factor (%)], REMOVEFILTERS ( dim_date ), dim_date[year] = 2024 )
			RETURN
			    IF (
			        [Grid Selected] && NOT ISBLANK ( pk ),
			        country & ": demand peaked at " & FORMAT ( pk, "#,0" ) & " MW in 2024; load factor " & FORMAT ( lf, "0" ) & "%",
			        "Grid load"
			    )
