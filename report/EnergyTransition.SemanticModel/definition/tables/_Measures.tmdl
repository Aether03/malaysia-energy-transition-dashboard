		isNameInferred
		sourceColumn: [Value]

	measure 'Reliability Metric' = SELECTEDVALUE ( reliability_metric[metric_code], "SAIFI" )
		displayFolder: State reliability
		lineageTag: dcc6c35f-0fca-4fa7-abd3-edd817f05a77

	measure 'Reliability Year' = SELECTEDVALUE ( reliability_year[year], MAX ( reliability_year[year] ) )
		formatString: 0
		displayFolder: State reliability
		lineageTag: fc6782ec-fb2d-4837-bc5f-e0323b08041b

	measure 'Reliability Unit' = IF ( [Reliability Metric] = "SAIDI", "minutes per customer per year", "interruptions per customer per year" )
		displayFolder: State reliability
		lineageTag: 9effe27b-6f03-4439-b37e-cb762bb545ae

	measure 'Reliability Raw' = IF ( [Reliability Metric] = "SAIDI", AVERAGE ( state_reliability[saidi_min] ), AVERAGE ( state_reliability[saifi] ) )
		formatString: 0.00
		displayFolder: State reliability
		lineageTag: 6112d337-2041-4397-8649-1b465a628507

	measure 'Reliability Value' =
			VAR y = [Reliability Year]
			RETURN CALCULATE ( [Reliability Raw], dim_year[year] = y )
		formatString: 0.00
		displayFolder: State reliability
		lineageTag: 943c5ab6-1f7c-4256-b7ff-53720f29a6f3

	measure 'Reliability Rank' =
			VAR v = [Reliability Value]
			RETURN
			    IF (
			        HASONEVALUE ( dim_state[state_code] ) && NOT ISBLANK ( v ),
			        RANKX ( FILTER ( ALL ( dim_state ), NOT ISBLANK ( [Reliability Value] ) ), [Reliability Value], v, ASC, SKIP )
			    )
		formatString: 0
		displayFolder: State reliability
		lineageTag: 649a9bd3-c188-420d-ae35-cb63192d7570

	measure 'Reliability Change Since 2015' =
			VAR v = [Reliability Value]
			VAR base = CALCULATE ( [Reliability Raw], dim_year[year] = 2015 )
			RETURN IF ( NOT ISBLANK ( v ) && NOT ISBLANK ( base ), v - base )
		formatString: +0.00;-0.00;0.00
		displayFolder: State reliability
		lineageTag: 8a5d143d-7f8e-4402-8153-1d973ed009d5

	measure 'Reliability Selected State' = IF ( HASONEVALUE ( dim_state[state_code] ), [Reliability Raw] )
		formatString: 0.00
		displayFolder: State reliability
		lineageTag: a9abaad1-b702-4415-b690-e080f50fc17b

	measure 'Reliability Peninsular' =
			VAR code = IF ( [Reliability Metric] = "SAIDI", "SAIDI_MIN", "SAIFI" )
			RETURN CALCULATE ( SUM ( region_annual[value] ), region_annual[metric_code] = code, dim_region[region_code] = "PEN" )
		formatString: 0.00
		displayFolder: State reliability
		lineageTag: 1a422289-b5b6-4d30-82cc-6a0716a3f12e

	measure 'Reliability Trend Title' =
			VAR who = IF ( HASONEVALUE ( dim_state[name] ), VALUES ( dim_state[name] ) & " vs Peninsular Malaysia", "Peninsular Malaysia (click a state to compare)" )
			RETURN who & " · " & [Reliability Metric] & " by year"
		displayFolder: State reliability
		lineageTag: 92e1583d-85ee-41a0-a371-df8a2801edfc

	measure 'P3b Title' =
			VAR y = [Reliability Year]
			VAR states = FILTER ( ALL ( dim_state ), NOT ISBLANK ( [Reliability Value] ) )
			VAR worst = MAXX ( TOPN ( 1, states, [Reliability Value], DESC, dim_state[name], ASC ), dim_state[name] )
			VAR best = MAXX ( TOPN ( 1, states, [Reliability Value], ASC, dim_state[name], ASC ), dim_state[name] )
			RETURN worst & " had the least reliable supply in " & y & ", " & best & " the most (" & [Reliability Metric] & ")"
		displayFolder: State reliability
		lineageTag: 11532b6e-b94a-42c8-aea7-ecbad7c3afe5

	measure 'P3b Subtitle' = "Peninsular Malaysia · " & [Reliability Metric] & ", " & [Reliability Unit] & " · " & [Reliability Year] & " · Source: Energy Commission"
		displayFolder: State reliability
		lineageTag: f976b825-eed6-480c-821a-51f391f18c1f

	measure 'Handbook Consent Notice' =
			VAR s = LOOKUPVALUE ( data_source[consent_status], data_source[data_source_code], "D5" )
			RETURN
			    SWITCH (
			        s,
			        "GRANTED", "Charts adapted from the handbook with the Energy Commission's written permission (9 October 2026). Not endorsed by the Energy Commission.",
			        "REQUESTED", "Derived charts for non-commercial portfolio use; written permission requested from the Energy Commission.",
			        "Derived charts for non-commercial portfolio use; written permission to be requested from the Energy Commission."
			    )
		displayFolder: State reliability
		lineageTag: 129800e5-463e-413a-a7de-ab25265a2389

	measure 'P3b Footnote' = "Source: Energy Commission, Malaysia Energy Statistics Handbook 2023 (pp. 83-84). " & [Handbook Consent Notice] & " Boundaries © OpenStreetMap contributors, via geoBoundaries (ODbL 1.0). Putrajaya includes Cyberjaya."
		displayFolder: State reliability
		lineageTag: 3ca62d9e-9bb1-42c0-9461-3ec2de70a273

