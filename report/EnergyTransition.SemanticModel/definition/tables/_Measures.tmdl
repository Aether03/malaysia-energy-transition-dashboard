		lineageTag: 685ba842-9183-446a-abea-3959b4dd37fd

	measure 'Region SAIFI Year' = CALCULATE ( MAX ( region_annual[year] ), region_annual[metric_code] = "SAIFI" )
		formatString: 0
		displayFolder: Regions
		lineageTag: 77d1cf31-664d-42c7-bbb8-655769cadcaa

	measure 'Region SAIFI' =
