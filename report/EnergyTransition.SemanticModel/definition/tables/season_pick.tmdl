table season_pick

	column grid_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: grid_key

	column season
		dataType: string
		summarizeBy: none
		sourceColumn: season
		sortByColumn: season_order

	column season_order
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: season_order

	partition season_pick = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    season_pick = Source{[Schema="mart",Item="season_pick"]}[Data]
				in
				    season_pick

