table run_latest

	column run_id
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: run_id

	column started_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: started_at

	column finished_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: finished_at

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	partition run_latest = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    run_latest = Source{[Schema="mart",Item="run_latest"]}[Data]
				in
				    run_latest
