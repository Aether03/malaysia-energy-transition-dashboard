table grid_flow_daily

	column grid_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: grid_key

	column counterparty
		dataType: string
		summarizeBy: none
		sourceColumn: counterparty

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: date_key

	column date
		dataType: dateTime
		isHidden
		formatString: Long Date
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column hours_present
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: hours_present

	column export_mwh
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: export_mwh

	column import_mwh
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: import_mwh

	column net_flow_mw
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: net_flow_mw

	partition grid_flow_daily = m
		mode: import
		source =
				let
				    Source = Sql.Database(SqlServer, SqlDatabase),
				    grid_flow_daily = Source{[Schema="mart",Item="grid_flow_daily"]}[Data]
				in
				    grid_flow_daily

