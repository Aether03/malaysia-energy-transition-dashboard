          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Method notes",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#0b0b0b",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Forecast: LightGBM issued at local midnight, scored once on a locked 2024 backtest against a seasonal-naive baseline (the same hour last week). The verdict is on the Forecast page.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Capacity factor = generation ÷ (capacity × hours in the year); blank if capacity is unreported.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "States: handbook labels map to states through a reference table; reliability by state covers Peninsular states only, and Sabah includes Labuan.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sarawak: the 2023 handbook prints each Sarawak reliability year one year early, so the years are remapped (see docs/reconciliation.md).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Data lag: Ember runs to 2025 (Brunei, Laos and Myanmar to 2024); grid load covers 2023-24; DOSM supply ends in June 2024 and is a cross-check only.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#0b0b0b"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
